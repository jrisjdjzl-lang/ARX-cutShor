# ==============================================================================
# ARX-cutShor — Environment Configuration Template (.env.example)
# Developer: Abdullah Alasaad
# Project: ARX-cutShor
# IMPORTANT: Copy this file to .env and fill in real values locally.
# NEVER commit .env, client_secret.json, or tokens.json to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Execution Mode & Environment
# ------------------------------------------------------------------------------
# APP_ENV: development | testing | production
APP_ENV=development

# DRY_RUN: true | false
# When true: simulates Drive sync, scheduling, and YouTube upload without side effects.
DRY_RUN=true

# PUBLISHING_MODE: testing | scheduled | public
# 'testing' forces Private/Unlisted uploads and blocks public publishing.
PUBLISHING_MODE=testing

# ALLOW_PUBLIC_PUBLISHING: explicit safety gate (must be true to allow public videos)
ALLOW_PUBLIC_PUBLISHING=false

# ------------------------------------------------------------------------------
# 2. Local Paths & Storage
# ------------------------------------------------------------------------------
DATABASE_PATH=data/db/arx_cutshor.db
WORKSPACE_DIR=data/workspace
ASSETS_DIR=data/assets
REPORTS_DIR=data/reports
LOGS_DIR=logs
MAX_TEMP_STORAGE_MB=5000
AUTO_CLEANUP_TEMP=true

# FFmpeg / ffprobe binaries (leave as 'ffmpeg' / 'ffprobe' if in system PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ------------------------------------------------------------------------------
# 3. Google Drive Integration
# ------------------------------------------------------------------------------
GDRIVE_ENABLED=false
GDRIVE_CLIENT_SECRET_FILE=credentials/gdrive_client_secret.json
GDRIVE_TOKEN_FILE=credentials/gdrive_token.json

# Google Drive Folder IDs (Use fixed Drive IDs, not folder names alone)
GDRIVE_ROOT_FOLDER_ID=
GDRIVE_INPUT_FOLDER_ID=
GDRIVE_PROCESSING_FOLDER_ID=
GDRIVE_READY_FOLDER_ID=
GDRIVE_PUBLISHED_FOLDER_ID=
GDRIVE_FAILED_FOLDER_ID=
GDRIVE_ASSETS_FOLDER_ID=
GDRIVE_REPORTS_FOLDER_ID=

# ------------------------------------------------------------------------------
# 4. Video Splitting & Processing Settings
# ------------------------------------------------------------------------------
# SPLIT_MODE: fixed | scene | manual | hybrid
SPLIT_MODE=fixed
TARGET_CLIP_DURATION_SEC=55.0
MIN_CLIP_DURATION_SEC=15.0
MAX_CLIP_DURATION_SEC=59.0
SAFE_END_MARGIN_SEC=0.5
SCENE_THRESHOLD=0.35

# Target Output Resolution (9:16 Vertical for YouTube Shorts)
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30

# ------------------------------------------------------------------------------
# 5. Channel Identity & Branding Template Defaults
# ------------------------------------------------------------------------------
CHANNEL_NAME=ARX Shorts
DEFAULT_SERIES_NAME=السلسلة الرئيسية
DEFAULT_LANGUAGE=ar
REQUIRE_RIGHTS_CONFIRMATION=true

# ------------------------------------------------------------------------------
# 6. Metadata & Optional AI Provider
# ------------------------------------------------------------------------------
# AI_PROVIDER: none | openai_compatible | gemini
# System works 100% locally with template rules when AI_PROVIDER=none
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# ------------------------------------------------------------------------------
# 7. Scheduling Engine
# ------------------------------------------------------------------------------
TIMEZONE=Asia/Riyadh
DAILY_CLIP_LIMIT=3
ALLOWED_PUBLISH_DAYS=0,1,2,3,4,5,6
PUBLISH_HOURS=14:00,18:00,21:00
MIN_INTERVAL_MINUTES=120
MAX_RETRY_ATTEMPTS=3

# ------------------------------------------------------------------------------
# 8. YouTube Data API v3 Integration
# ------------------------------------------------------------------------------
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_SECRET_FILE=credentials/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json
YOUTUBE_CATEGORY_ID=22
YOUTUBE_DEFAULT_PRIVACY=private

# ------------------------------------------------------------------------------
# 9. Management Web UI & Security
# ------------------------------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Optional local access token to protect management API/Dashboard
ADMIN_ACCESS_TOKEN=arx_local_dev_token_change_me

# ------------------------------------------------------------------------------
# 10. Optional Free Notifications (Webhook / Telegram)
# ------------------------------------------------------------------------------
NOTIFICATION_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

